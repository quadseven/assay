
__pycache__/
!suites/*/data/README.md
.DS_Store
.promptfoo/
.pytest_cache/
.ruff_cache/
.venv/
*.parquet
*.py[cod]
# and large; they are downloaded, never committed.
# Benchmark corpora. Both are redistribution-restricted (see suites/nutrition/data/README.md)
# Local-only leak-scan term list; the scanner is published, the terms are not.
# Promptfoo run output. `index.md` and `README.md` under results/ are tracked;
# the raw run JSON is not.
suites/*/data/*
suites/*/results/*.json
tools/leakscan.local.txt
# The curated per-suite summary the README scoreboard is generated from IS
# tracked; only the raw run JSON above is not. Without this exception the
# generator finds zero measurements in CI and the README check fails.
!suites/*/results/scoreboard.json
# Keep the frozen default-model runs so the published nutrition results can be regraded.
!suites/nutrition/results/nemotron-3-nano-base.json
!suites/nutrition/results/nemotron-3-nano-default-thinking.json
# The loom_gates replay records ARE tracked: each is a few dozen KB of gate
# verdicts, and the test suite re-grades them to their recorded summary.
!suites/loom_gates/results/*.json

# lane_review --pipeline model reply cache (lr_pipeline.py).
.cache/

# pr_review: private-repository seeds, cases and per-case detail never land in a tracked file.
suites/pr_review/seeds.private.json
suites/pr_review/cases.private.json
# pr_review run records ARE tracked: tests re-grade them to their stored summary.
!suites/pr_review/results/20*.json
# review_quality's derived reviewer chain IS tracked: a test holds it to the published table.
!suites/review_quality/results/chain.json
